/* 全局样式 - 黑白配色 */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 20rpx 30rpx;
  padding-bottom: 320rpx;
}

/* 按钮 */
.btn-primary {
  background-color: #000;
  color: white;
  padding: 24rpx 48rpx;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
  margin: 16rpx 0;
}

.btn-primary[disabled] {
  background-color: #ccc;
  color: #999;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333;
  padding: 16rpx 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-secondary.warning {
  background-color: #fff3e0;
  color: #e65100;
  border-color: #ffcc80;
}

.btn-secondary.danger {
  background-color: #ffebee;
  color: #c62828;
  border-color: #ffcdd2;
}

/* 状态 */
.status-bar {
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.status-bar.disconnected {
  background-color: #f5f5f5;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.status-bar.connected {
  background-color: #000;
  color: #fff;
}

/* 设置区块 */
.settings-section {
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 36rpx;
  background-color: #fafafa;
  border-bottom: 2rpx solid #f0f0f0;
  font-weight: 600;
  color: #333;
  font-size: 30rpx;
}

.section-content {
  padding: 30rpx 36rpx;
}

.setting-item {
  margin-bottom: 24rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  font-weight: 600;
  color: #555;
  font-size: 28rpx;
}

.setting-value {
  color: #000;
  font-weight: 600;
  font-size: 28rpx;
}

/* 进度条 */
.transfer-container {
  margin: 24rpx 0;
  padding: 24rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
}

.transfer-status {
  text-align: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 32rpx;
  background-color: #e8e8e8;
  border-radius: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #000;
  transition: width 0.3s ease;
  border-radius: 16rpx;
}

.transfer-progress {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  font-weight: 600;
}

/* 文件列表 */
.file-list {
  max-height: 300rpx;
  overflow-y: auto;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.file-item:last-child {
  border-bottom: none;
}

.file-item.displaying {
  background-color: #f5f5f5;
  border-left: 6rpx solid #000;
}

.file-id {
  min-width: 60rpx;
  font-weight: 600;
  color: #000;
  margin-right: 20rpx;
  font-size: 26rpx;
}

.file-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  color: #333;
}

.empty-state {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 模式选择 */
.mode-selector {
  display: flex;
  gap: 20rpx;
}

.mode-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background-color: #f5f5f5;
  border: 4rpx solid transparent;
  border-radius: 16rpx;
  color: #666;
  font-weight: 600;
  font-size: 26rpx;
}

.mode-button.active {
  background-color: #f0f0f0;
  border-color: #000;
  color: #000;
}

/* 开关 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.switch-row:last-child {
  border-bottom: none;
}

/* 按钮行 */
.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row .btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 画布容器（宝丽来风格） */
.canvas-container {
  background: #fff;
  padding: 40rpx 30rpx 80rpx 30rpx;
  border-radius: 6rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1), 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  margin: 24rpx auto;
  width: fit-content;
  max-width: 100%;
}

/* Frame tabs */
.frame-tabs {
  display: flex;
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.frame-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  font-weight: 600;
  font-size: 28rpx;
  color: #999;
  border-bottom: 6rpx solid transparent;
}

.frame-tab.active {
  color: #000;
  border-bottom-color: #000;
  background-color: #fafafa;
}

/* 信息文本 */
.info-text {
  color: #999;
  font-size: 24rpx;
  text-align: center;
  margin: 16rpx 0;
}

.success-text {
  color: #333;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.error-text {
  color: #c62828;
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* 滑块 */
.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.slider-label {
  flex: 0 0 180rpx;
  font-weight: 600;
  color: #555;
  font-size: 26rpx;
}

.slider-row slider {
  flex: 1;
}

.slider-value {
  flex: 0 0 80rpx;
  text-align: right;
  font-weight: 600;
  font-size: 26rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn-group .btn-secondary {
  flex: 1;
  min-width: 140rpx;
  text-align: center;
}

/* 操作项 */
.action-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.action-item:last-child {
  border-bottom: none;
}

.action-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
  color: #555;
  font-size: 28rpx;
}

.action-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.file-size-text {
  font-size: 24rpx;
  color: #999;
}

/* 唤醒滑块 */
.wake-slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wake-min, .wake-max {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

.wake-slider-row slider {
  flex: 1;
}

/* 调试日志 */
.debug-log {
  background-color: #1a1a1a;
  color: #d4d4d4;
  padding: 16rpx;
  font-family: monospace;
  font-size: 20rpx;
  max-height: 300rpx;
  overflow-y: auto;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.debug-entry {
  margin: 4rpx 0;
  padding: 4rpx 0;
  border-bottom: 2rpx solid #333;
}

.debug-entry.error {
  color: #f48771;
}

.debug-entry.success {
  color: #89d185;
}

.debug-entry.info {
  color: #75beff;
}

/* 全局动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes progressPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.8; }
}

/* 卡片入场动画 */
.settings-section {
  animation: slideUp 0.4s ease both;
}

/* 按钮点击反馈 */
.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-secondary:active {
  transform: scale(0.97);
  background-color: #e8e8e8;
}

/* 传输进度动画 */
.transfer-container {
  animation: scaleIn 0.3s ease;
}

.progress-fill {
  animation: progressPulse 2s ease-in-out infinite;
}

/* 页面切换过渡 */
.page-enter {
  animation: fadeIn 0.3s ease;
}
