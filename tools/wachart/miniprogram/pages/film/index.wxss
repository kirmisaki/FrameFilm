/* Film 页面样式 */

.container {
  padding: 30rpx;
  padding-bottom: 120rpx;
}

/* 参数设置面板 */
.settings-section {
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 36rpx;
  background-color: #f8f9fa;
  border-bottom: 2rpx solid #e9ecef;
  font-weight: 600;
  color: #333;
  font-size: 30rpx;
}

.section-content {
  padding: 30rpx 36rpx;
}

.setting-item {
  margin-bottom: 24rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  font-weight: 600;
  color: #555;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

/* Picker 样式 */
.picker-value {
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

/* 滑块行 */
.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.slider-label {
  flex: 0 0 160rpx;
  font-weight: 600;
  color: #555;
  font-size: 26rpx;
}

.slider-row slider {
  flex: 1;
}

.slider-value {
  flex: 0 0 80rpx;
  text-align: right;
  font-weight: 600;
  font-size: 26rpx;
  color: #000;
}

/* 按钮组 */
.btn-group {
  display: grid !important;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn-group .btn-secondary {
  text-align: center;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  padding: 14rpx 8rpx;
  margin: 0;
  box-sizing: border-box;
  min-height: 0;
  line-height: 1.4;
  flex: none !important;
  min-width: 0 !important;
  width: 100%;
}

.btn-group .btn-secondary.active {
  background-color: #f0f0f0;
  border-color: #000;
  color: #000;
}

/* Canvas 容器（宝丽来风格） */
.canvas-container {
  background: #fff;
  padding: 70rpx 50rpx 120rpx 50rpx;
  border-radius: 6rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12), 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  margin: 24rpx auto;
  width: fit-content;
  max-width: 100%;
}

.canvas-wrap {
  width: 540rpx;
  height: 810rpx;
  overflow: hidden;
  position: relative;
  touch-action: none;
  margin: 0 auto;
}

.film-canvas {
  width: 540rpx;
  height: 810rpx;
}

/* 文件名输入 */
.file-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.file-name-row .setting-label {
  flex: 0 0 120rpx;
  margin-bottom: 0;
}

.file-name-input {
  flex: 1;
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

/* 下载/发送按钮行 */
.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row .btn-primary {
  flex: 1;
}

.btn-bluetooth {
  background-color: #000 !important;
}

.btn-bluetooth[disabled] {
  background-color: #ccc !important;
}

/* 传输进度 */
.transfer-container {
  margin: 24rpx 0;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx solid #ddd;
}

.transfer-status {
  text-align: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 32rpx;
  background-color: #e0e0e0;
  border-radius: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #000;
  transition: width 0.3s ease;
  border-radius: 16rpx;
}

.transfer-progress {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  font-weight: 600;
}

/* 结果信息 */
.info-text {
  color: #666;
  font-size: 26rpx;
  text-align: center;
  margin: 16rpx 0;
  word-break: break-all;
}
