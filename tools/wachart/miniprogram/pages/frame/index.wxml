<view class="container">
  <view class="feature-list">
    <view class="feature-card" bindtap="goToUpload">
      <view class="feature-icon-area">
        <view class="feature-icon-circle upload-bg">
          <view class="icon-album">
            <view class="album-body"></view>
            <view class="album-mountain"></view>
            <view class="album-sun"></view>
          </view>
        </view>
      </view>
      <view class="feature-name">拾光</view>
      <view class="feature-arrow">›</view>
    </view>
    <view class="feature-card" bindtap="goToCamera">
      <view class="feature-icon-area">
        <view class="feature-icon-circle camera-bg">
          <view class="icon-camera">
            <view class="cam-body"></view>
            <view class="cam-lens"></view>
            <view class="cam-flash"></view>
          </view>
        </view>
      </view>
      <view class="feature-name">定影</view>
      <view class="feature-arrow">›</view>
    </view>
    <view class="feature-card" bindtap="goToQuote">
      <view class="feature-icon-area">
        <view class="feature-icon-circle quote-bg">
          <view class="icon-quote">
            <view class="quote-mark">"</view>
          </view>
        </view>
      </view>
      <view class="feature-name">一言</view>
      <view class="feature-arrow">›</view>
    </view>
  </view>
</view>
