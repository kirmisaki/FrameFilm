/* Frame 主页面 - 功能入口列表 */
.container {
  padding: 30rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 30rpx 36rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease;
}

.feature-card:active {
  transform: scale(0.98);
}

/* 图标区域 */
.feature-icon-area {
  margin-right: 36rpx;
  flex-shrink: 0;
}

.feature-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 莫兰迪色系背景 */
.upload-bg {
  background: linear-gradient(135deg, #8b7d78, #a3938e);
}

.camera-bg {
  background: linear-gradient(135deg, #7a8b7a, #95a895);
}

.quote-bg {
  background: linear-gradient(135deg, #7a8594, #94a0b0);
}

/* 相册图标 */
.icon-album {
  width: 40rpx;
  height: 34rpx;
  position: relative;
}

.album-body {
  width: 40rpx;
  height: 30rpx;
  border: 3rpx solid rgba(255,255,255,0.9);
  border-radius: 4rpx;
  position: absolute;
  bottom: 0;
  box-sizing: border-box;
}

.album-mountain {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 12rpx solid rgba(255,255,255,0.7);
  position: absolute;
  left: 4rpx;
  bottom: 6rpx;
}

.album-sun {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.8);
  position: absolute;
  right: 6rpx;
  top: 4rpx;
}

/* 相机图标 */
.icon-camera {
  width: 44rpx;
  height: 32rpx;
  position: relative;
}

.cam-body {
  width: 44rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255,255,255,0.9);
  border-radius: 6rpx;
  position: absolute;
  bottom: 0;
  box-sizing: border-box;
}

.cam-lens {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid rgba(255,255,255,0.9);
  border-radius: 50%;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.cam-flash {
  width: 12rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: rgba(255,255,255,0.7);
  position: absolute;
  left: 8rpx;
  top: -2rpx;
}

/* 引号图标 */
.icon-quote {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.quote-mark {
  font-size: 56rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 700;
  font-family: Georgia, serif;
  line-height: 1;
}

/* 文字 */
.feature-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  letter-spacing: 2rpx;
}

.feature-arrow {
  font-size: 44rpx;
  color: #ccc;
  font-weight: 300;
  line-height: 1;
  flex-shrink: 0;
}
