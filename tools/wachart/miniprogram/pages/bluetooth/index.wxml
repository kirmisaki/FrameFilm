<view class="container">
  <view class="status-bar {{isConnected ? 'connected' : 'disconnected'}}">
    {{statusText}}
  </view>

  <button class="btn-primary" bindtap="onScan" disabled="{{isConnected}}">
    {{isScanning ? '扫描中...' : '扫描设备'}}
  </button>

  <view wx:if="{{deviceList.length > 0}}" class="device-list">
    <view wx:for="{{deviceList}}" wx:key="deviceId" class="device-item" bindtap="onConnectDevice" data-index="{{index}}">
      <view class="device-info">
        <view class="device-name">{{item.name || '未知设备'}}</view>
        <view class="device-id">{{item.deviceId}}</view>
      </view>
      <text class="device-rssi">{{item.RSSI}}dBm</text>
    </view>
  </view>

  <view wx:if="{{isConnected}}" class="connected-info">
    <view class="settings-section">
      <view class="section-header">已连接设备</view>
      <view class="section-content">
        <view class="setting-item">
          <text class="setting-label">设备名称: </text>
          <text class="setting-value">{{connectedDeviceName}}</text>
        </view>
        <view class="setting-item">
          <text class="setting-label">电量: </text>
          <text class="setting-value">{{batteryLevel}}%</text>
        </view>
        <button class="btn-secondary danger" style="width:100%;margin-top:20rpx;" bindtap="onDisconnect">断开连接</button>
      </view>
    </view>
  </view>

  <view wx:if="{{!isConnected && !isScanning}}" class="info-text">
    点击扫描按钮搜索FrameFilm设备
  </view>
</view>
