<view class="container">
  <view class="canvas-container">
    <view class="canvas-wrap" style="height: {{boxH}}rpx">
      <canvas type="2d" id="canvas-upload" class="preview-canvas"
              bindtouchstart="onTouchStart" catchtouchmove="onTouchMove"
              bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></canvas>
      <view wx:if="{{showAdjustHint}}" class="adjust-hint">双指缩放 · 单指拖动 · 松手 1s 后刷新</view>
    </view>
  </view>

  <!-- 色彩调节（作用于默认转换算法，对比度/饱和度默认 1.0） -->
  <view class="color-panel" wx:if="{{imgLoaded}}">
    <view class="color-head">
      <text class="color-title">色彩调节</text>
      <text class="color-reset" bindtap="resetColors">重置</text>
    </view>
    <view class="slider-row">
      <text class="slider-label">对比度</text>
      <slider min="50" max="200" step="10" value="{{contrastInt}}" bindchanging="onContrastChanging" bindchange="onContrastChange" activeColor="#FF6B6B" block-size="24" />
      <text class="slider-value">{{contrast}}</text>
    </view>
    <view class="slider-row">
      <text class="slider-label">饱和度</text>
      <slider min="0" max="30" step="1" value="{{saturationInt}}" bindchanging="onSaturationChanging" bindchange="onSaturationChange" activeColor="#FF6B6B" block-size="24" />
      <text class="slider-value">{{saturation}}</text>
    </view>
  </view>

  <view class="button-row">
    <button class="btn-secondary" bindtap="chooseImage">从相册选择</button>
    <button class="btn-secondary {{adjustOn ? 'btn-adjust-on' : ''}}" bindtap="toggleAdjust">{{adjustOn ? '✓ 调节中' : '调节'}}</button>
    <button class="btn-primary btn-send" disabled="{{sendDisabled}}" bindtap="sendToDevice">发送到设备</button>
  </view>

  <!-- 文件名重命名 -->
  <view wx:if="{{showFileName}}" class="filename-area">
    <view wx:if="{{!isEditingName}}" class="filename-display" bindtap="startEditName">
      <text class="filename-label">文件名</text>
      <text class="filename-value">{{customFileName || 'upload.film'}}</text>
      <text class="filename-edit">修改</text>
    </view>
    <view wx:else class="filename-edit-row">
      <text class="filename-label">文件名</text>
      <input class="filename-input" value="{{customFileName}}" placeholder="upload" bindinput="onFileNameInput" bindblur="onFileNameBlur" focus="{{isEditingName}}" />
      <text class="filename-ext">.film</text>
    </view>
  </view>

  <view wx:if="{{showTransfer}}" class="transfer-overlay">
    <view class="transfer-modal">
      <view class="flight-area">
        <view class="airplane {{transferProgress >= 100 ? 'airplane-done' : ''}}"></view>
        <view class="flight-trail"></view>
      </view>
      <view class="transfer-percent">{{transferProgress}}%</view>
      <view class="transfer-msg">{{transferStatus}}</view>
      <view class="modal-progress-bar">
        <view class="modal-progress-fill" style="width: {{transferProgress}}%"></view>
      </view>
    </view>
  </view>

  <view class="tab-bar-spacer"></view>
</view>
