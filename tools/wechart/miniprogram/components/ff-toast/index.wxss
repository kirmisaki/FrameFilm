.fftoast {
  position: fixed;
  left: 50%;
  top: calc(16px + env(safe-area-inset-top));
  transform: translateX(-50%);
  max-width: 82vw;
  padding: 10px 16px;
  border: 3px solid #12100E;
  border-radius: 14px;
  background: #FFFFFF;
  box-shadow: 0 4px 0 #12100E;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  z-index: 999;
  animation: fftoastIn .2s ease both;
}

.fftoast--ok {
  background: #3ED6A8;
}

.fftoast--warn {
  background: #FFD84D;
}

.fftoast--error {
  background: #FF6B5A;
  color: #FFFFFF;
}

@keyframes fftoastIn {
  from { opacity: 0; transform: translate(-50%, -8px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
