:host {
  display: block;
  width: 100%;
}

.ffselect {
  margin-bottom: 14px;
}

.ffselect.is-disabled {
  opacity: .5;
}

.ffselect__label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 7px;
}

.ffselect__control {
  min-height: 44px;
  padding: 11px 13px;
  border: 3px solid #12100E;
  border-radius: 12px;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.ffselect__text {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ffselect__arrow {
  font-size: 14px;
  color: #5B544A;
}

.ffselect__mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(18, 16, 14, .38);
  z-index: 200;
}

.ffselect__sheet {
  position: fixed;
  left: 12px;
  right: 12px;
  bottom: calc(12px + env(safe-area-inset-bottom));
  max-height: 62vh;
  background: #FFFFFF;
  border: 3px solid #12100E;
  border-radius: 26px;
  box-shadow: 0 8px 0 #12100E;
  z-index: 201;
  overflow: hidden;
}

.ffselect__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 2px dashed #E7DFCE;
}

.ffselect__title {
  font-size: 15px;
  font-weight: 800;
}

.ffselect__close {
  width: 30px;
  height: 30px;
  border: 2px solid #12100E;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
}

.ffselect__list {
  max-height: 48vh;
}

.ffselect__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 13px 16px;
  border-bottom: 2px dashed #F1EADA;
  font-size: 15px;
  font-weight: 600;
}

.ffselect__item:last-child {
  border-bottom: none;
}

.ffselect__item.is-on {
  background: #FFF6C9;
}

.ffselect__item.is-disabled {
  color: #B7B0A4;
}

.ffselect__check {
  font-size: 15px;
  font-weight: 900;
}
