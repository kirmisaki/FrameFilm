<view class="container">
  <!-- 页面头部：电量图标右上角 -->
  <view class="page-header" wx:if="{{isConnected}}">
    <view class="header-spacer"></view>
    <view class="battery-bar" bindtap="refreshBattery">
      <view class="battery-icon">
        <view class="battery-body">
          <view class="battery-fill-view" style="width: {{batteryFillWidth}}rpx"></view>
        </view>
        <view class="battery-cap"></view>
      </view>
      <text class="battery-text">{{batteryLevel}}%</text>
    </view>
  </view>

  <!-- FILM设置 -->
  <view class="settings-section">
    <view class="section-header">FILM设置</view>
    <view class="section-content">
      <!-- 文件列表 -->
      <view class="setting-item">
        <view class="setting-label">
          文件列表
          <text class="refresh-btn" bindtap="refreshFileList">刷新</text>
        </view>
        <view class="file-list">
          <block wx:if="{{fileList.length > 0}}">
            <view
              class="file-item {{item.fileId === currentDisplayFileId ? 'displaying' : ''}} {{item.fileId === selectedFileId ? 'selected' : ''}}"
              wx:for="{{fileList}}"
              wx:key="fileId"
              bindtap="onFileSelect"
              data-file-id="{{item.fileId}}"
            >
              <text class="file-id">#{{item.fileId}}</text>
              <text class="file-name">{{item.name}}</text>
              <text class="file-tag" wx:if="{{item.fileId === currentDisplayFileId}}">显示中</text>
            </view>
          </block>
          <view wx:else class="empty-state">暂无文件</view>
        </view>
      </view>

      <!-- 文件操作按钮 -->
      <view class="button-row">
        <button class="btn-secondary danger" bindtap="deleteSelectedFile" disabled="{{selectedFileId < 0}}">删除文件</button>
        <button class="btn-primary" bindtap="selectDisplayFile" disabled="{{selectedFileId < 0}}">选择显示</button>
      </view>

      <!-- 照片模式 -->
      <view class="setting-item mode-section">
        <view class="setting-label">照片模式</view>
        <view class="mode-selector">
          <view class="mode-button {{photoMode === 2 ? 'active' : ''}} {{wifiEnable ? '' : 'hidden'}}" bindtap="setWifiMode" data-mode="wifi">
            <text>WiFi轮播</text>
          </view>
          <view class="mode-button {{photoMode === 1 ? 'active' : ''}}" bindtap="setLocalMode" data-mode="auto">
            <text>本地轮播</text>
          </view>
          <view class="mode-button {{photoMode === 0 ? 'active' : ''}}" bindtap="setManualMode" data-mode="manual">
            <text>关闭</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 网络配置 -->
  <view class="settings-section">
    <view class="section-header">
      <text>网络配置</text>
    </view>
    <view class="section-content network-content">
      <!-- WiFi 开关 -->
      <view class="switch-row">
        <text class="setting-label">WiFi</text>
        <switch checked="{{wifiEnable}}" color="#4CAF50" bindchange="onWifiEnableChange" disabled="{{!isConnected}}" />
      </view>
      <!-- SSID -->
      <view class="network-input-group">
        <text class="network-label">SSID</text>
        <input class="network-input" value="{{wifiSsid}}" placeholder="输入WiFi名称" bindblur="applyWifiSsid" disabled="{{!isConnected}}" />
      </view>
      <!-- 密码 -->
      <view class="network-input-group">
        <text class="network-label">密码</text>
        <input class="network-input" value="{{wifiPassword}}" type="password" placeholder="输入WiFi密码" bindblur="applyWifiPassword" disabled="{{!isConnected}}" />
      </view>
      <!-- 连接/断开按钮 -->
      <view class="button-row">
        <button class="btn-secondary" bindtap="onWifiConnect" disabled="{{!isConnected}}">连接</button>
        <button class="btn-secondary" bindtap="onWifiDisconnect" disabled="{{!isConnected}}">断开</button>
      </view>
      <!-- 连接状态 -->
      <view class="wifi-status-row">
        <view class="wifi-status-dot {{wifiConnected ? 'connected' : ''}}"></view>
        <text class="wifi-status-text">{{wifiStatusText}}</text>
      </view>
      <view class="divider"></view>
      <!-- API地址 -->
      <view class="network-input-group">
        <text class="network-label">API地址</text>
        <input class="network-input" value="{{filmApiUrl}}" placeholder="http://..." bindblur="applyFilmApiUrl" disabled="{{!isConnected}}" />
      </view>
      <view class="button-row">
        <button class="btn-secondary" bindtap="applyFilmApiUrl" disabled="{{!isConnected}}">设置</button>
        <button class="btn-secondary" bindtap="onFilmDownload" disabled="{{!isConnected}}">下载测试</button>
      </view>
      <view class="wifi-status-row" wx:if="{{downloadStatusText}}">
        <text class="wifi-status-text" style="font-size:12px;color:#999;">{{downloadStatusText}}</text>
      </view>
      <button class="btn-secondary danger" bindtap="onWifiClear" disabled="{{!isConnected}}" style="width:100%;margin-top:10px;">清除网络配置</button>
    </view>
  </view>

  <!-- 休眠设置 -->
  <view class="settings-section">
    <view class="section-header">休眠设置</view>
    <view class="section-content">
      <view class="switch-row">
        <text class="setting-label">休眠开关</text>
        <switch checked="{{sleepOnOff}}" color="#4CAF50" bindchange="onSleepSwitchChange" />
      </view>
      <view class="switch-row">
        <text class="setting-label">自动唤醒</text>
        <switch checked="{{autoWakeMode}}" color="#4CAF50" bindchange="onAutoWakeSwitchChange" />
      </view>
      <view class="setting-item wake-duration-item">
        <view class="setting-label">唤醒时长: <text class="setting-value">{{wakeDurationText}}</text></view>
        <view class="wake-slider-row">
          <text class="wake-min">10分钟</text>
          <slider
            min="0"
            max="{{wakeMaxIndex}}"
            step="1"
            value="{{wakeIndex}}"
            activeColor="#4CAF50"
            bindchanging="onWakeChanging"
            bindchange="onWakeChange"
          />
          <text class="wake-max">48小时</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 设备控制 -->
  <view class="settings-section">
    <view class="section-header">设备控制</view>
    <view class="section-content">
      <!-- 调试 -->
      <view class="action-item">
        <view class="action-header">
          <text>调试模式</text>
        </view>
        <view class="action-controls">
          <button class="btn-secondary" bindtap="toggleDebug">{{showDebug ? '隐藏日志' : '显示日志'}}</button>
        </view>
      </view>

      <!-- 调试日志 -->
      <view class="debug-log" wx:if="{{showDebug}}">
        <view class="debug-entry {{item.type}}" wx:for="{{debugLogs}}" wx:key="index">
          {{item.text}}
        </view>
        <view class="debug-entry info" wx:if="{{debugLogs.length === 0}}">暂无日志</view>
      </view>

      <!-- OTA升级 -->
      <view class="action-item">
        <view class="action-header">
          <text>OTA 升级</text>
        </view>
        <view class="action-controls">
          <button class="btn-secondary" bindtap="chooseOtaFile">选择固件</button>
          <text class="file-size-text" wx:if="{{otaFileName}}">{{otaFileName}} ({{otaFileSize}} 字节)</text>
        </view>
        <view class="button-row" wx:if="{{otaFileData}}">
          <button class="btn-primary" bindtap="startOtaUpgrade" disabled="{{showOtaTransfer}}">开始升级</button>
        </view>
      </view>

      <!-- OTA传输进度 -->
      <view class="transfer-container" wx:if="{{showOtaTransfer}}">
        <view class="transfer-status">{{otaTransferStatus}}</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{otaTransferProgress}}%"></view>
        </view>
        <view class="transfer-progress">{{otaTransferProgress}}%</view>
      </view>

      <!-- 设备管理 -->
      <view class="action-item">
        <view class="action-header">
          <text>设备管理</text>
        </view>
        <view class="action-controls">
          <button class="btn-secondary" bindtap="reboot">重启设备</button>
          <button class="btn-secondary danger" bindtap="reset">恢复出厂</button>
          <button class="btn-secondary danger" bindtap="sdFormat">SD格式化</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位，防止被 tabBar 遮挡 -->
  <view class="tab-bar-spacer"></view>
</view>
