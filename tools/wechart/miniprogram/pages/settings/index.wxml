<view class="container">
  <!-- 页面头部：电量图标右上角 -->
  <view class="page-header" wx:if="{{isConnected}}">
    <view class="header-spacer"></view>
    <view class="battery-bar" bindtap="refreshBattery">
      <view class="battery-icon">
        <view class="battery-body">
          <view class="battery-fill-view" style="width: {{batteryFillWidth}}rpx"></view>
        </view>
        <view class="battery-cap"></view>
      </view>
      <text class="battery-text">{{batteryLevel}}%</text>
    </view>
  </view>

  <!-- 组1 FILM 设备 -->
  <view class="set-group">
    <!-- 设备照片：跳转片单 -->
    <view class="set-row" bindtap="goFilmlist">
      <view class="set-ic sc-red"><image src="/images/icons/white/photo-file.svg" mode="aspectFit"></image></view>
      <view class="set-t">设备照片
        <text class="set-d">{{fileList.length > 0 ? fileList.length + ' 张' : '前往片单管理'}}</text>
      </view>
      <view class="set-a">›</view>
    </view>

    <!-- 照片模式 -->
    <view class="set-row">
      <view class="set-ic sc-teal"><image src="/images/icons/white/photo-mode.svg" mode="aspectFit"></image></view>
      <view class="set-t">照片模式
        <text class="set-d">{{photoModeText}}</text>
      </view>
    </view>
    <view class="set-panel">
      <view class="mode-selector">
        <view class="mode-button {{photoMode === 2 ? 'active' : ''}} {{wifiEnable ? '' : 'hidden'}}" bindtap="setWifiMode" data-mode="wifi">WiFi轮播</view>
        <view class="mode-button {{photoMode === 1 ? 'active' : ''}}" bindtap="setLocalMode" data-mode="auto">本地轮播</view>
        <view class="mode-button {{photoMode === 0 ? 'active' : ''}}" bindtap="setManualMode" data-mode="manual">关闭</view>
      </view>
    </view>
  </view>

  <!-- 组2 网络配置 -->
  <view class="set-group">
    <view class="set-row">
      <view class="set-ic sc-purple"><image src="/images/icons/white/network.svg" mode="aspectFit"></image></view>
      <view class="set-t">网络配置
        <text class="set-d">{{wifiStatusText}}</text>
      </view>
      <view class="set-a" bindtap="toggleNetworkSection">{{networkExpanded ? '−' : '＋'}}</view>
    </view>

    <view class="set-panel" wx:if="{{networkExpanded}}">
      <!-- WiFi 开关 -->
      <view class="switch-row">
        <text class="setting-label">WiFi</text>
        <switch checked="{{wifiEnable}}" color="#4ECDC4" bindchange="onWifiEnableChange" disabled="{{!isConnected}}" />
      </view>
      <!-- SSID -->
      <view class="network-input-group">
        <text class="network-label">SSID</text>
        <input class="network-input" value="{{wifiSsid}}" placeholder="输入WiFi名称" bindblur="applyWifiSsid" disabled="{{!isConnected}}" />
      </view>
      <!-- 密码 -->
      <view class="network-input-group">
        <text class="network-label">密码</text>
        <input class="network-input" value="{{wifiPassword}}" type="password" placeholder="输入WiFi密码" bindblur="applyWifiPassword" disabled="{{!isConnected}}" />
      </view>
      <!-- 连接/断开按钮 -->
      <view class="button-row">
        <button class="btn-secondary" bindtap="onWifiConnect" disabled="{{!isConnected}}">连接</button>
        <button class="btn-secondary" bindtap="onWifiDisconnect" disabled="{{!isConnected}}">断开</button>
      </view>
      <!-- 连接状态 -->
      <view class="wifi-status-row">
        <view class="wifi-status-dot {{wifiConnected ? 'connected' : ''}}"></view>
        <text class="wifi-status-text">{{wifiStatusText}}</text>
      </view>
      <view class="divider"></view>
      <!-- API地址 -->
      <view class="network-input-group">
        <text class="network-label">API地址</text>
        <input class="network-input" value="{{filmApiUrl}}" placeholder="http://..." bindblur="applyFilmApiUrl" disabled="{{!isConnected}}" />
      </view>
      <view class="button-row">
        <button class="btn-secondary" bindtap="applyFilmApiUrl" disabled="{{!isConnected}}">设置</button>
        <button class="btn-secondary" bindtap="onFilmDownload" disabled="{{!isConnected}}">下载测试</button>
      </view>
      <view class="wifi-status-row" wx:if="{{downloadStatusText}}">
        <text class="wifi-status-text download-text">{{downloadStatusText}}</text>
      </view>
      <button class="btn-secondary danger wide-btn" bindtap="onWifiClear" disabled="{{!isConnected}}">清除网络配置</button>
    </view>
  </view>

  <!-- 组3 设备 -->
  <view class="set-group">
    <!-- 休眠 -->
    <view class="set-row">
      <view class="set-ic sc-blue"><image src="/images/icons/white/sleep.svg" mode="aspectFit"></image></view>
      <view class="set-t">休眠开关</view>
      <switch checked="{{sleepOnOff}}" color="#4ECDC4" bindchange="onSleepSwitchChange" />
    </view>
    <view class="set-row">
      <view class="set-ic sc-yellow"><image src="/images/icons/white/auto-wake.svg" mode="aspectFit"></image></view>
      <view class="set-t">自动唤醒</view>
      <switch checked="{{autoWakeMode}}" color="#4ECDC4" bindchange="onAutoWakeSwitchChange" />
    </view>
    <view class="set-row">
      <view class="set-ic sc-pink"><image src="/images/icons/white/wake-time.svg" mode="aspectFit"></image></view>
      <view class="set-t">唤醒时长
        <text class="set-d">{{wakeDurationText}}</text>
      </view>
    </view>
    <view class="set-panel">
      <view class="wake-slider-row">
        <text class="wake-min">10分钟</text>
        <slider
          min="0"
          max="{{wakeMaxIndex}}"
          step="1"
          value="{{wakeIndex}}"
          activeColor="#4ECDC4"
          block-color="#4ECDC4"
          bindchanging="onWakeChanging"
          bindchange="onWakeChange"
        />
        <text class="wake-max">48小时</text>
      </view>
    </view>

    <!-- OTA 升级 -->
    <view class="set-row">
      <view class="set-ic sc-red"><image src="/images/icons/white/ota.svg" mode="aspectFit"></image></view>
      <view class="set-t">OTA 升级</view>
    </view>
    <view class="set-panel">
      <view class="action-controls">
        <button class="btn-secondary" bindtap="chooseOtaFile">选择固件</button>
        <text class="file-size-text" wx:if="{{otaFileName}}">{{otaFileName}} ({{otaFileSize}} 字节)</text>
      </view>
      <view class="button-row" wx:if="{{otaFileData}}">
        <button class="btn-primary" bindtap="startOtaUpgrade" disabled="{{showOtaTransfer}}">开始升级</button>
      </view>
      <view class="transfer-container" wx:if="{{showOtaTransfer}}">
        <view class="transfer-status">{{otaTransferStatus}}</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{otaTransferProgress}}%"></view>
        </view>
        <view class="transfer-progress">{{otaTransferProgress}}%</view>
      </view>
    </view>

    <!-- 调试日志 -->
    <view class="set-row" bindtap="toggleDebug">
      <view class="set-ic sc-teal"><image src="/images/icons/white/debug.svg" mode="aspectFit"></image></view>
      <view class="set-t">调试日志</view>
      <view class="set-a">{{showDebug ? '−' : '＋'}}</view>
    </view>
    <view class="set-panel" wx:if="{{showDebug}}">
      <view class="debug-log">
        <view class="debug-entry {{item.type}}" wx:for="{{debugLogs}}" wx:key="index">
          {{item.text}}
        </view>
        <view class="debug-entry info" wx:if="{{debugLogs.length === 0}}">暂无日志</view>
      </view>
    </view>

    <!-- 设备管理 -->
    <view class="set-row">
      <view class="set-ic sc-purple"><image src="/images/icons/white/device.svg" mode="aspectFit"></image></view>
      <view class="set-t">设备管理</view>
    </view>
    <view class="set-panel">
      <view class="action-controls">
        <button class="btn-secondary" bindtap="reboot">重启设备</button>
        <button class="btn-secondary danger" bindtap="reset">恢复出厂</button>
        <button class="btn-secondary danger" bindtap="sdFormat">SD格式化</button>
      </view>
    </view>
  </view>

  <!-- 组4 关于 -->
  <view class="set-group">
    <view class="set-row" bindtap="showHelp">
      <view class="set-ic sc-blue"><image src="/images/icons/white/help.svg" mode="aspectFit"></image></view>
      <view class="set-t">帮助与反馈</view>
      <view class="set-a">›</view>
    </view>
    <view class="set-row" bindtap="showAbout">
      <view class="set-ic sc-yellow"><image src="/images/icons/white/about.svg" mode="aspectFit"></image></view>
      <view class="set-t">关于 FrameFilm
        <text class="set-d">v2.0</text>
      </view>
      <view class="set-a">›</view>
    </view>
  </view>

  <!-- 底部占位，防止被 tabBar 遮挡 -->
  <view class="tab-bar-spacer"></view>
</view>
