.container {
  padding: 20rpx 30rpx;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.header-spacer {
  flex: 1;
}

/* 电量条 */
.battery-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  background-color: #FAFAFB;
  border: 2rpx solid #ECECEE;
  border-radius: 999rpx;
}

.battery-icon {
  display: flex;
  align-items: center;
}

.battery-body {
  width: 52rpx;
  height: 26rpx;
  border: 3rpx solid #111;
  border-radius: 6rpx;
  padding: 3rpx;
  display: flex;
  align-items: center;
}

.battery-fill-view {
  height: 100%;
  background-color: #FF6B6B;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.battery-cap {
  width: 6rpx;
  height: 14rpx;
  background-color: #111;
  border-radius: 0 3rpx 3rpx 0;
  margin-left: 2rpx;
}

.battery-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #111;
}

/* 创作页默认转换算法行：两行信息（标题+当前值 / 作用范围说明） */
.create-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.create-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
  max-width: 100%;
}

.create-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
}

.create-val {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.create-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9B93A4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* 分组内嵌面板 */
.set-panel {
  padding: 24rpx 40rpx 36rpx;
  background: #FBFBFC;
  border-top: 2rpx solid #F3F3F5;
}

.set-ic image {
  width: 40rpx;
  height: 40rpx;
}

/* 彩色图标块 */
.sc-red {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
}
.sc-teal {
  background: linear-gradient(135deg, #4ECDC4, #2EB6AC);
}
.sc-purple {
  background: linear-gradient(135deg, #845EC2, #6B45A6);
}
.sc-blue {
  background: linear-gradient(135deg, #4D96FF, #2F6FD8);
}
.sc-yellow {
  background: linear-gradient(135deg, #FFD93D, #FFB03D);
}
.sc-pink {
  background: linear-gradient(135deg, #FF8FC7, #FF6FA8);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: white;
  padding: 24rpx 32rpx;
  border: none;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 107, 0.28);
}

.btn-primary[disabled] {
  background-color: #ccc;
  color: #999;
}

.btn-secondary {
  background-color: #fff;
  color: #111;
  padding: 20rpx 24rpx;
  border: 2rpx solid #D9D9DD;
  border-radius: 20rpx;
  font-size: 28rpx;
  flex: 1;
}

.btn-secondary[disabled] {
  opacity: 0.5;
}

.btn-secondary.danger {
  background-color: #fff;
  color: #c62828;
  border-color: #e8b4b4;
}

.wide-btn {
  width: 100%;
  margin: 8rpx 0;
}

/* 按钮行 */
.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.button-row button {
  flex: 1;
  width: auto;
  margin: 0;
}

/* 模式选择 */
.mode-selector {
  display: flex;
  gap: 20rpx;
}

.mode-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 12rpx;
  background-color: #fff;
  border: 2rpx solid #D9D9DD;
  border-radius: 20rpx;
  color: #9A9AA2;
  font-weight: 600;
  font-size: 26rpx;
}

.mode-button.active {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 107, 0.25);
}

.mode-button.hidden {
  display: none;
}

/* 开关行 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.setting-label {
  font-weight: 600;
  color: #111;
  font-size: 28rpx;
}

/* 唤醒时长 */
.wake-slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wake-min, .wake-max {
  font-size: 22rpx;
  color: #9A9AA2;
  white-space: nowrap;
}

.wake-slider-row slider {
  flex: 1;
}

/* 操作控件 */
.action-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.file-size-text {
  font-size: 24rpx;
  color: #9A9AA2;
}

/* 调试日志 */
.debug-log {
  background-color: #3A3A44;
  color: #d4d4d4;
  padding: 16rpx;
  font-family: monospace;
  font-size: 20rpx;
  max-height: 300rpx;
  overflow-y: auto;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.debug-entry {
  margin: 4rpx 0;
  padding: 4rpx 0;
  border-bottom: 2rpx solid #2a2a2a;
}

.debug-entry.error {
  color: #f48771;
}

.debug-entry.success {
  color: #89d185;
}

.debug-entry.info {
  color: #75beff;
}

/* 传输进度 */
.transfer-container {
  margin: 24rpx 0;
  padding: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #ECECEE;
}

.transfer-status {
  text-align: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 32rpx;
  background-color: #ECECEE;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF9F6B);
  transition: width 0.3s ease;
  border-radius: 999rpx;
}

.transfer-progress {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  font-weight: 600;
}

/* 网络配置 */
.network-input-group {
  margin-bottom: 20rpx;
}

.network-label {
  font-size: 26rpx;
  color: #9A9AA2;
  margin-bottom: 8rpx;
  display: block;
}

.network-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ECECEE;
  border-radius: 20rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.wifi-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0;
}

.wifi-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #C9C9CF;
}

.wifi-status-dot.connected {
  background-color: #2ECC71;
}

.wifi-status-text {
  font-size: 26rpx;
  color: #9A9AA2;
}

.download-text {
  font-size: 22rpx;
}

.divider {
  height: 2rpx;
  background-color: #ECECEE;
  margin: 20rpx 0;
}

/* tab-bar 占位 */
.tab-bar-spacer {
  height: 120rpx;
}
