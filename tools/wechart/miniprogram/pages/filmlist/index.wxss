/* 片单页样式 - 依赖全局 app.wxss 公共类 */

/* 批量传输弹窗 */
.transfer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.transfer-modal {
  width: 560rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 56rpx 48rpx;
  text-align: center;
  animation: scaleIn 0.3s ease;
}

.transfer-percent {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF6B6B;
  letter-spacing: 2rpx;
}

.transfer-msg {
  font-size: 26rpx;
  color: #9A9AA2;
  margin: 16rpx 0 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #F0E4DE;
  border-radius: 999rpx;
  overflow: hidden;
}

.modal-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF9F6B);
  transition: width 0.3s ease;
  border-radius: 999rpx;
}

/* 失败后退出按钮 */
.transfer-exit {
  margin: 32rpx auto 0;
  width: 220rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 107, 0.28);
}

/* 批量发送青绿 CTA */
.cta-teal {
  background: linear-gradient(135deg, #4ECDC4, #2EB6AC);
  box-shadow: 0 10rpx 22rpx rgba(78, 205, 196, 0.3);
}

/* 面板头部可点按钮（选图/刷新） */
.panel-head .cnt {
  color: #2EB6AC;
  padding: 8rpx 20rpx;
  background: rgba(78, 205, 196, 0.12);
  border-radius: 999rpx;
}

/* 片单缩略图 */
.lr-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #F6EFEA;
}

/* 片单大图预览弹窗 */
.preview-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.6);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-modal {
  width: 620rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
  animation: scaleIn 0.3s ease;
}

.preview-img {
  width: 100%;
  max-height: 760rpx;
  border-radius: 24rpx;
  background: #F6EFEA;
}

.preview-name {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #3A3A44;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-close {
  margin: 28rpx auto 0;
  width: 200rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 107, 0.28);
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
