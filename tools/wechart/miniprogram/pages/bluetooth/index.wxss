/* 蓝牙页面样式 - 方案E多巴胺彩色 */

/* 状态卡片 */
.status-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  border-radius: 40rpx;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.status-disconnected {
  background: #ffffff;
  border: 2rpx solid transparent;
  box-shadow: 0 10rpx 26rpx rgba(132, 94, 194, 0.12);
}

.status-connected {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 107, 0.3);
}

.status-icon-wrap {
  flex-shrink: 0;
}

.status-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F4F0FA, #E9E2F5);
  color: #845EC2;
  position: relative;
  transition: all 0.3s ease;
}

/* 扫描中：青绿底色 + 雷达扩散环 */
.status-icon.scanning {
  background: rgba(78, 205, 196, 0.14);
  color: #2EB6AC;
  animation: pulse 1.5s ease-in-out infinite;
}

.status-icon.scanning::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(78, 205, 196, 0.45);
  animation: radar 1.6s ease-out infinite;
}

.status-icon.connected {
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.status-ico {
  width: 44rpx;
  height: 44rpx;
}

.status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.status-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #3A3A44;
}

.status-connected .status-title {
  color: #fff;
}

.status-sub {
  font-size: 24rpx;
  color: #9B93A4;
}

.status-connected .status-sub {
  opacity: 0.8;
  color: #fff;
}

/* 电量条 */
.battery-bar {
  flex-shrink: 0;
}

.battery-body {
  width: 56rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 6rpx;
  padding: 3rpx;
  position: relative;
}

.battery-body::after {
  content: '';
  position: absolute;
  right: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 0 2rpx 2rpx 0;
}

.battery-fill {
  height: 100%;
  background: #fff;
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

/* 操作按钮 */
.action-buttons {
  margin-bottom: 30rpx;
}

.action-buttons .btn-primary,
.action-buttons .btn-disconnect {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  width: 100%;
}

.action-buttons .btn-primary {
  height: 104rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 107, 0.3);
}

.action-buttons .btn-primary[disabled] {
  opacity: 0.75;
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #fff;
}

.btn-ico {
  width: 40rpx;
  height: 40rpx;
}

.scanning-btn {
  animation: scanPulse 2s ease-in-out infinite;
}

.action-buttons .btn-disconnect {
  height: 96rpx;
  background: #ffffff;
  color: #FF6B6B;
  border: 2rpx solid #FFC7B8;
  margin: 16rpx 0;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 107, 0.1);
}

.btn-disconnect::after {
  border: none;
}

/* 设备列表 */
.device-list {
  animation: fadeSlideUp 0.4s ease;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.list-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #9B93A4;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.list-count {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #4ECDC4, #2EB6AC);
  box-shadow: 0 4rpx 10rpx rgba(78, 205, 196, 0.3);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.device-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 30rpx;
  background: #ffffff;
  border-radius: 32rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(132, 94, 194, 0.1);
  animation: fadeSlideUp 0.3s ease both;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.device-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(132, 94, 194, 0.14);
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #4ECDC4, #2EB6AC);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 6rpx 14rpx rgba(78, 205, 196, 0.25);
}

.device-icon image {
  width: 40rpx;
  height: 40rpx;
}

.device-icon.pro {
  background: linear-gradient(135deg, #845EC2, #6B45A6);
  box-shadow: 0 6rpx 14rpx rgba(132, 94, 194, 0.3);
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-name {
  font-weight: 800;
  font-size: 30rpx;
  color: #3A3A44;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dev-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #845EC2;
  background: rgba(132, 94, 194, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.device-id {
  font-size: 22rpx;
  color: #9B93A4;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 信号强度指示 */
.device-signal {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.signal-bar {
  width: 8rpx;
  background: #E8E2EC;
  border-radius: 2rpx;
  transition: background 0.3s ease;
}

.signal-bar.bar1 { height: 12rpx; }
.signal-bar.bar2 { height: 22rpx; }
.signal-bar.bar3 { height: 32rpx; }

.signal-bar.active {
  background: #4ECDC4;
}

/* 提示区域 */
.hint-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 40rpx;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 40rpx;
  margin-top: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(132, 94, 194, 0.1);
}

.hint-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFF1DC, #FFE3B8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #D9822B;
}

.hint-text {
  font-size: 24rpx;
  color: #9B93A4;
  letter-spacing: 1rpx;
}

/* 动画关键帧 */
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.8; }
}

@keyframes radar {
  0% { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(1.8); opacity: 0; }
}

@keyframes scanPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
