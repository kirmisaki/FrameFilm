<view class="container">
  <!-- 连接状态卡片 -->
  <view class="status-card {{isConnected ? 'status-connected' : 'status-disconnected'}}">
    <view class="status-icon-wrap">
      <view class="status-icon {{isScanning ? 'scanning' : ''}} {{isConnected ? 'connected' : ''}}">
        <image wx:if="{{isConnected}}" class="status-ico" src="/images/icons/white/check.svg" mode="aspectFit"></image>
        <image wx:elif="{{isScanning}}" class="status-ico" src="/images/icons/scan.svg" mode="aspectFit"></image>
        <image wx:else class="status-ico" src="/images/icons/bluetooth.svg" mode="aspectFit"></image>
      </view>
    </view>
    <view class="status-info">
      <text class="status-title">{{isConnected ? connectedDeviceName : (isScanning ? '正在搜索...' : '未连接')}}</text>
      <text class="status-sub">{{isConnected ? '电量 ' + batteryLevel + '%' : statusText}}</text>
    </view>
    <view wx:if="{{isConnected}}" class="battery-bar">
      <view class="battery-body">
        <view class="battery-fill" style="width: {{batteryFillWidth}}%"></view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button wx:if="{{!isConnected}}" class="btn-primary {{isScanning ? 'scanning-btn' : ''}}" bindtap="onScan" disabled="{{isScanning}}">
      <image class="btn-ico" src="/images/icons/white/scan.svg" mode="aspectFit"></image>
      <text>{{isScanning ? '扫描中...' : '扫描设备'}}</text>
    </button>
    <button wx:if="{{isConnected}}" class="btn-disconnect" bindtap="onDisconnect">
      <image class="btn-ico" src="/images/icons/link-off.svg" mode="aspectFit"></image>
      <text>断开连接</text>
    </button>
  </view>

  <!-- 设备列表 -->
  <view wx:if="{{deviceList.length > 0}}" class="device-list">
    <view class="list-header">
      <text class="list-title">发现的设备</text>
      <text class="list-count">{{deviceList.length}}</text>
    </view>
    <view wx:for="{{deviceList}}" wx:key="deviceId"
      class="device-item"
      bindtap="onConnectDevice"
      data-index="{{index}}"
      style="animation-delay: {{index * 80}}ms">
      <view class="device-icon {{item.isPro ? 'pro' : ''}}">
        <image src="/images/icons/white/epd.svg" mode="aspectFit"></image>
      </view>
      <view class="device-info">
        <view class="device-name">
          <text>{{item.name || '未知设备'}}</text>
          <text class="dev-tag" wx:if="{{item.modelTag}}">{{item.modelTag}}</text>
        </view>
        <view class="device-id">{{item.deviceId}}</view>
      </view>
      <view class="device-signal">
        <view class="signal-bar bar1 {{item.RSSI > -80 ? 'active' : ''}}"></view>
        <view class="signal-bar bar2 {{item.RSSI > -60 ? 'active' : ''}}"></view>
        <view class="signal-bar bar3 {{item.RSSI > -40 ? 'active' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 提示信息 -->
  <view wx:if="{{!isConnected && !isScanning && deviceList.length === 0}}" class="hint-area">
    <image class="hint-icon" src="/images/icons/white/bluetooth.svg" mode="aspectFit"></image>
    <text class="hint-text">点击上方按钮搜索 FrameFilm 设备</text>
  </view>

  <!-- 底部占位，防止被 tabBar 遮挡 -->
  <view class="tab-bar-spacer"></view>
</view>
