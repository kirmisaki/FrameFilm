.container {
  padding: 20rpx 30rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #845EC2, #6B45A6);
  color: white;
  padding: 24rpx 48rpx;
  border: none;
  border-radius: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
  margin: 0;
  box-shadow: 0 10rpx 22rpx rgba(132, 94, 194, 0.3);
}

.btn-secondary {
  background-color: #ffffff;
  color: #845EC2;
  padding: 16rpx 32rpx;
  border: 2rpx solid #E8DCF2;
  border-radius: 32rpx;
  font-size: 28rpx;
  flex: 1;
}

.quote-controls {
  display: flex;
  gap: 16rpx;
}

.custom-panel {
  background-color: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border: 2rpx solid #e9ecef;
}

.custom-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  font-size: 28rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.custom-input {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  background-color: #fff;
  box-sizing: border-box;
  height: 100rpx;
}

.canvas-container {
  background: #fff;
  padding: 60rpx 40rpx 100rpx 40rpx;
  border-radius: 6rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12), 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  margin: 16rpx auto;
  width: fit-content;
  max-width: 100%;
}

.canvas-wrap {
  width: 600rpx;
  height: 900rpx;
  overflow: hidden;
  position: relative;
  border: 2rpx solid #e0e0e0;
}

.preview-canvas {
  width: 100%;
  height: 100%;
}

.dither-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.dither-label {
  font-size: 24rpx;
  color: #999;
}

/* 飞行传输弹窗 */
.transfer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.transfer-modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
  animation: scaleIn 0.3s ease;
}

.flight-area {
  height: 110rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.airplane {
  font-size: 72rpx;
  color: #845EC2;
  position: absolute;
  top: 0;
  animation: flyAcross 2s linear infinite;
}

.airplane-done {
  animation: flyOut 0.6s ease forwards;
}

.flight-trail {
  position: absolute;
  bottom: 8rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #ddd 20%, #ddd 80%, transparent);
  animation: trailPulse 1.5s ease-in-out infinite;
}

.transfer-percent {
  font-size: 44rpx;
  font-weight: 700;
  color: #845EC2;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.transfer-msg {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
}

.modal-progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #EEE4F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.modal-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #845EC2, #6B45A6);
  transition: width 0.3s ease;
  border-radius: 8rpx;
}

@keyframes flyAcross {
  0% { left: -10%; }
  100% { left: 100%; }
}

@keyframes flyOut {
  0% { left: 50%; opacity: 1; }
  100% { left: 120%; opacity: 0; }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes trailPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.8; }
}

.tab-bar-spacer {
  height: 160rpx;
}
