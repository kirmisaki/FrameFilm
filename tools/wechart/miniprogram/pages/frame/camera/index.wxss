.container {
  padding: 20rpx 30rpx;
}

.btn-primary {
  background-color: #000;
  color: white;
  padding: 24rpx 48rpx;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
  margin: 0;
}

.btn-primary[disabled] {
  background-color: #ccc;
  color: #999;
}

.button-row {
  display: flex;
  gap: 16rpx;
  max-width: 668rpx;
  margin: 40rpx auto 0;
}

.button-row .btn-primary {
  flex: 1;
}

.canvas-container {
  background: #fff;
  padding: 60rpx 40rpx 100rpx 40rpx;
  border-radius: 6rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12), 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  margin: 16rpx auto;
  width: fit-content;
  max-width: 100%;
}

.canvas-wrap {
  width: 600rpx;
  height: 900rpx;
  overflow: hidden;
  position: relative;
  border: 2rpx solid #e0e0e0;
}

.preview-canvas {
  width: 100%;
  height: 100%;
}

/* 飞行传输弹窗 */
.transfer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.transfer-modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
  animation: scaleIn 0.3s ease;
}

.flight-area {
  height: 110rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.airplane {
  font-size: 72rpx;
  color: #7a8594;
  position: absolute;
  top: 0;
  animation: flyAcross 2s linear infinite;
}

.airplane-done {
  animation: flyOut 0.6s ease forwards;
}

.flight-trail {
  position: absolute;
  bottom: 8rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #ddd 20%, #ddd 80%, transparent);
  animation: trailPulse 1.5s ease-in-out infinite;
}

.transfer-percent {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.transfer-msg {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
}

.modal-progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.modal-progress-fill {
  height: 100%;
  background: #7a8594;
  transition: width 0.3s ease;
  border-radius: 8rpx;
}

@keyframes flyAcross {
  0% { left: -10%; }
  100% { left: 100%; }
}

@keyframes flyOut {
  0% { left: 50%; opacity: 1; }
  100% { left: 120%; opacity: 0; }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes trailPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.8; }
}

.tab-bar-spacer {
  height: 160rpx;
}

/* 文件名重命名 */
.filename-area {
  max-width: 668rpx;
  margin: 12rpx auto 0;
}

.filename-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.filename-label {
  font-size: 24rpx;
  color: #bbb;
  flex-shrink: 0;
}

.filename-value {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

.filename-edit {
  font-size: 22rpx;
  color: #aaa;
  padding: 4rpx 16rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.filename-edit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.filename-input {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  min-width: 0;
}

.filename-ext {
  font-size: 24rpx;
  color: #bbb;
  flex-shrink: 0;
}
