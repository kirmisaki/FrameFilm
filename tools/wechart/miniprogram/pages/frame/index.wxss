.frame-screen {
  padding-bottom: 110px;
}

.canvas-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.frame-canvas {
  display: block;
  background: #FFFFFF;
  border: 2px solid #12100E;
  border-radius: 6px;
}

.canvas-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: rgba(255, 248, 231, .85);
}
