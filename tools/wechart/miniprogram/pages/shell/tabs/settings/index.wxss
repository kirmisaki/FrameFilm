button.btn {
  margin: 0;
  padding: 0 8px;
}

.film-file-selection {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 10px 0;
}

.wake-slider {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 4px;
}

.wake-slider__control {
  flex: 1;
  min-width: 0;
}

.wake-min,
.wake-max {
  flex: none;
  font-size: 11.5px;
  color: #5B544A;
  white-space: nowrap;
}

.action-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
  font-size: 14.5px;
  font-weight: 800;
}

.action-ic {
  width: 18px;
  height: 18px;
}

.mode-button image {
  width: 24px;
  height: 24px;
}
