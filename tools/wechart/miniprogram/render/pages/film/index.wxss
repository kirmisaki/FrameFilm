.film-screen {
  padding-bottom: 140px;
}

.canvas-wrap {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF8E7;
  overflow: hidden;
}

.film-canvas {
  display: block;
  background: #FFFFFF;
  border: 2px solid #12100E;
  border-radius: 10px;
}

.canvas-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: rgba(255, 248, 231, .82);
}

.canvas-empty__title {
  font-size: 14px;
  font-weight: 700;
  color: #5B544A;
}

.adaptive-text {
  margin-top: 8px;
  padding: 8px 10px;
  border: 2px dashed #D8CBB0;
  border-radius: 12px;
  font-size: 12px;
  color: #5B544A;
}

button.btn {
  margin: 0;
}

.preview-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

.preview-actions .btn {
  flex: 1;
  min-width: 0;
  padding: 0 8px;
  font-size: 13px;
}
