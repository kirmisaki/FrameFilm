/* ============================================================
   FrameFilm 小程序设计系统
   对齐 tools/ForFilm/css/style.css 经典版：
   奶油底 / 3px 墨线 / 大圆角 / 柠檬+珊瑚强调色
   ============================================================ */

page {
  --cream: #FFF8E7;
  --cream-2: #FFFDF6;
  --paper: #FFFFFF;
  --ink: #12100E;
  --ink-soft: #5B544A;
  --ink-faint: #9A9388;
  --lemon: #D8F14A;
  --coral: #FF6B5A;
  --sky: #4FB3FF;
  --mint: #3ED6A8;
  --sun: #FFD84D;
  --line: 3px;
  --r-xs: 12px;
  --r-sm: 16px;
  --r: 20px;
  --r-lg: 26px;

  background-color: var(--cream);
  background-image:
    radial-gradient(circle at 10% -6%, rgba(216, 241, 74, .55), transparent 40%),
    radial-gradient(circle at 92% 4%, rgba(79, 179, 255, .38), transparent 36%),
    radial-gradient(circle at 50% 104%, rgba(62, 214, 168, .35), transparent 44%),
    radial-gradient(var(--cream-2) 22%, transparent 23%);
  background-size: auto, auto, auto, 22px 22px;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'MiSans', 'Microsoft YaHei', sans-serif;
  font-size: 15px;
  line-height: 1.55;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0 18px;
  line-height: normal;
  font-weight: 800;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  padding: 0 18px 112px;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 2px 14px;
}

.topbar__back {
  width: 40px;
  height: 40px;
  border: var(--line) solid var(--ink);
  border-radius: 14px;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 800;
}

.topbar__title {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: .5px;
}

.topbar__main {
  flex: 1;
  min-width: 0;
}

.topbar__sub {
  font-size: 12px;
  color: var(--ink-soft);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spacer {
  flex: 1;
}

.card {
  background: var(--paper);
  border: var(--line) solid var(--ink);
  border-radius: var(--r);
  box-shadow: 5px 5px 0 var(--ink);
  padding: 18px;
  margin-bottom: 18px;
}

.card--flat {
  box-shadow: none;
}

.card__head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.card__title {
  font-size: 17px;
  font-weight: 800;
}

.card__hint {
  font-size: 12px;
  color: var(--ink-soft);
  margin-top: 6px;
  line-height: 1.45;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--ink-faint);
  flex: none;
}

.dot--on {
  background: var(--mint);
  box-shadow: 0 0 0 3px rgba(62, 214, 168, .18);
}

.row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.row--between {
  justify-content: space-between;
}

.row--wrap {
  flex-wrap: wrap;
}

.field {
  margin-bottom: 14px;
}

.field__label {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
  display: block;
}

.field__hint {
  font-size: 12px;
  color: var(--ink-faint);
  margin-top: 6px;
  line-height: 1.4;
}

.input {
  width: 100%;
  min-height: 44px;
  padding: 11px 13px;
  border: var(--line) solid var(--ink);
  border-radius: var(--r-xs);
  background: var(--paper);
  font-size: 15px;
  color: var(--ink);
}

.input:focus {
  background: var(--cream-2);
  box-shadow: 3px 3px 0 var(--ink);
}

.input--sm {
  min-height: 38px;
  padding: 8px 11px;
  font-size: 14px;
}

.btn {
  min-height: 44px;
  padding: 0 18px;
  border: var(--line) solid var(--ink);
  border-radius: var(--r-sm);
  background: var(--paper);
  color: var(--ink);
  font-size: 15px;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-shadow: 3px 3px 0 var(--ink);
  transition: transform .13s cubic-bezier(.2, 1.4, .4, 1), box-shadow .13s ease;
}

.btn:active {
  transform: translate(3px, 3px);
  box-shadow: 0 0 0 var(--ink);
}

.btn--primary {
  background: var(--lemon);
}

.btn--coral {
  background: var(--coral);
  color: #fff;
}

.btn--ghost {
  background: transparent;
  box-shadow: none;
}

.btn--sm {
  min-height: 36px;
  padding: 0 12px;
  font-size: 13px;
  border-width: 2px;
  border-radius: var(--r-xs);
  box-shadow: 0 2px 0 var(--ink);
}

.btn--danger {
  background: var(--coral);
  color: #fff;
}

.btn[disabled] {
  opacity: .45;
  box-shadow: none;
}

.btn--block {
  width: 100%;
}

.btn-row {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.btn-row > .btn {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.status {
  padding: 13px;
  margin-bottom: 14px;
  text-align: center;
  font-size: 15px;
  font-weight: 800;
  background: var(--coral);
  color: var(--paper);
  border: var(--line) solid var(--ink);
  border-radius: var(--r-sm);
  box-shadow: 3px 3px 0 var(--ink);
}

.status.connected {
  background: var(--mint);
  color: var(--ink);
}

.device-type-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.device-type-badge {
  padding: 2px 10px;
  font-size: 12.5px;
  font-weight: 800;
  background: var(--lemon);
  border: 2.5px solid var(--ink);
  border-radius: 999px;
}

.device-resolution {
  font-size: 12.5px;
  color: var(--ink-soft);
}

.value-chip {
  margin-left: auto;
  padding: 1px 10px 2px;
  font-size: 13px;
  font-weight: 800;
  background: var(--lemon);
  border: 2.5px solid var(--ink);
  border-radius: 999px;
}

.divider {
  height: 2.5px;
  margin: 14px 0;
  background: repeating-linear-gradient(90deg, var(--ink) 0 6px, transparent 6px 12px);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 2px dashed #E7DFCE;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-row__main {
  flex: 1;
  min-width: 0;
}

.switch-row__label {
  display: block;
  font-size: 14px;
  font-weight: 700;
}

.switch-row__hint {
  display: block;
  font-size: 11.5px;
  color: var(--ink-soft);
  margin-top: 2px;
  line-height: 1.4;
}

.wifi-status-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 0;
  font-size: 12.5px;
  color: var(--ink-soft);
}

.wifi-status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--ink-faint);
}

.wifi-status-dot--on {
  background: var(--mint);
  box-shadow: 0 0 0 3px rgba(62, 214, 168, .18);
}

.modes {
  display: flex;
  gap: 10px;
}

.mode-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 12px 6px;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--ink);
  background: var(--cream-2);
  border: var(--line) solid var(--ink);
  border-radius: var(--r-sm);
  box-shadow: 3px 3px 0 var(--ink);
}

.mode-button--on {
  background: var(--lemon);
}

.file-list {
  height: 180px;
  background: var(--cream-2);
  border: 2.5px solid var(--ink);
  border-radius: var(--r-xs);
}

.file-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: 2px dashed #E7DFCE;
}

.file-item:last-child {
  border-bottom: none;
}

.file-item--on {
  background: var(--mint);
}

.file-check {
  width: 19px;
  height: 19px;
  flex: none;
  border: 2.5px solid var(--ink);
  border-radius: 6px;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 900;
}

.file-check--on {
  background: var(--lemon);
}

.file-id {
  flex: none;
  min-width: 26px;
  padding: 1px 7px 2px;
  text-align: center;
  font-size: 12px;
  font-weight: 800;
  background: var(--lemon);
  border: 2.5px solid var(--ink);
  border-radius: 999px;
}

.file-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13.5px;
}

.debug-log {
  height: 200px;
  margin-top: 10px;
  padding: 10px 12px;
  background: var(--ink);
  color: #E8E3D6;
  border-radius: var(--r-xs);
  font-family: ui-monospace, Consolas, monospace;
  font-size: 11.5px;
  line-height: 1.5;
}

.debug-line {
  white-space: pre-wrap;
  word-break: break-all;
}

.debug-line--tx { color: #9FC9FF; }
.debug-line--rx { color: #8FE8DF; }

.result {
  margin-top: 12px;
  padding: 11px 14px;
  background: var(--cream-2);
  border: 2.5px solid var(--ink);
  border-radius: var(--r-xs);
  font-size: 12.5px;
  color: var(--ink-soft);
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border: 2px solid var(--ink);
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  background: var(--paper);
}

.chip--lemon { background: var(--lemon); }
.chip--mint { background: var(--mint); }
.chip--coral { background: var(--coral); color: #fff; }
.chip--sun { background: var(--sun); }

.glyph {
  font-style: normal;
  font-weight: 800;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tile-ic {
  width: 44px;
  height: 44px;
  border: var(--line) solid var(--ink);
  border-radius: 14px;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  font-weight: 900;
  flex: none;
}

.tile-ic--lemon { background: var(--lemon); }
.tile-ic--coral { background: var(--coral); color: #fff; }
.tile-ic--sky { background: var(--sky); color: #fff; }
.tile-ic--mint { background: var(--mint); }
.tile-ic--sun { background: var(--sun); }

.ic-wrap {
  width: 38px;
  height: 38px;
  flex: none;
  border-radius: 50%;
  border: var(--line) solid var(--ink);
  background: var(--lemon);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-wrap image {
  width: 20px;
  height: 20px;
  display: block;
}

.ic-wrap--coral { background: var(--coral); }
.ic-wrap--sky { background: var(--sky); }
.ic-wrap--mint { background: var(--mint); }
.ic-wrap--sun { background: var(--sun); }
.ic-wrap--paper { background: var(--paper); }

.polaroid {
  width: 100%;
  padding: 10px 10px 28px;
  background: var(--paper);
  border: 2.5px solid var(--ink);
  border-radius: var(--r-xs);
  box-shadow: 5px 5px 0 var(--ink);
}

.polaroid canvas {
  display: block;
  margin: 0 auto;
}

.app-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 0 14px;
}

.app-title {
  font-size: 23px;
  font-weight: 800;
  letter-spacing: .2px;
  line-height: 1.25;
}

.batt-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  background: var(--mint);
  border: var(--line) solid var(--ink);
  border-radius: 999px;
  box-shadow: 2px 2px 0 var(--ink);
  font-size: 13px;
  font-weight: 800;
}

.batt-chip--off {
  background: var(--paper);
  color: var(--ink-soft);
}

.switch {
  width: 58px;
  height: 32px;
  border: var(--line) solid var(--ink);
  border-radius: 999px;
  background: var(--cream);
  position: relative;
  flex: none;
  transition: background .18s;
}

.switch--on {
  background: var(--mint);
}

.switch::after {
  content: '';
  position: absolute;
  left: 2px;
  top: 2px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--paper);
  border: 2.5px solid var(--ink);
  transition: transform .2s cubic-bezier(.2, 1.4, .4, 1);
}

.switch--on::after {
  transform: translateX(26px);
}

.list {
  display: flex;
  flex-direction: column;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 2px dashed #E7DFCE;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row__main {
  flex: 1;
  min-width: 0;
}

.list-row__title {
  font-size: 15px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-row__sub {
  font-size: 12px;
  color: var(--ink-faint);
  margin-top: 3px;
}

.empty {
  text-align: center;
  color: var(--ink-faint);
  font-size: 13px;
  padding: 26px 10px;
}

.progress {
  height: 20px;
  border: 2.5px solid var(--ink);
  border-radius: 999px;
  background: var(--paper);
  overflow: hidden;
}

.progress__fill {
  height: 100%;
  background: repeating-linear-gradient(45deg, var(--coral) 0 8px, var(--sun) 8px 16px);
  transition: width .3s ease;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.grid-2 > .card {
  width: calc((100% - 12px) / 2);
  margin-bottom: 0;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  gap: 4px;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  background: var(--cream-2);
  border-top: var(--line) solid var(--ink);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 7px 4px 6px;
  border: var(--line) solid transparent;
  border-radius: var(--r-sm);
  color: var(--ink);
  font-size: 11.5px;
  font-weight: 700;
  transition: background .15s, transform .15s, box-shadow .15s, border-color .15s;
}

.nav-item--on {
  background: var(--paper);
  border-color: var(--ink);
  box-shadow: 3px 3px 0 var(--ink);
  transform: translateY(-3px);
}

.nav-icon {
  width: 23px;
  height: 23px;
  display: block;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  border: var(--line) solid var(--ink);
  border-radius: var(--r);
  background: var(--paper);
  box-shadow: 0 3px 0 var(--ink);
  margin-bottom: 14px;
}

.status-line__text {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-pane {
  display: block;
}

.hide {
  display: none !important;
}

.mono {
  font-family: ui-monospace, Consolas, monospace;
}

.small {
  font-size: 12px;
  color: var(--ink-soft);
}

.section-title {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  color: var(--ink-faint);
  margin: 20px 4px 10px;
  text-transform: uppercase;
}

.rise {
  animation: rise .35s cubic-bezier(.22, 1.2, .36, 1) both;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
