/* ===== FrameFilm 全局样式 · 多巴胺彩色 ===== */
/* 方案E Token：accent #FF6B6B / teal #4ECDC4 / yellow #FFD93D / purple #845EC2 / pink #FF8FC7 / blue #4D96FF */
/* bg #FFF6EE / card #FFF / ink #3A3A44 / sub #9B93A4 */

page {
  background: #FFF6EE;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #3A3A44;
  line-height: 1.6;
}

.container {
  padding: 40rpx 52rpx;
  padding-bottom: 240rpx;
}

/* 底部占位，防止内容被自定义 tabBar 遮挡 */
.tab-bar-spacer {
  height: 160rpx;
}

/* ---------- 英文小标 ---------- */
.label {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3px;
  color: #9B93A4;
  text-transform: uppercase;
  margin: 52rpx 4rpx 28rpx;
}
.label:first-child {
  margin-top: 8rpx;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border: none;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1px;
  width: 100%;
  margin: 16rpx 0;
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 107, 0.3);
}

.btn-primary[disabled] {
  background: #E8E0D6;
  color: #B0A69B;
  box-shadow: none;
}

.btn-secondary {
  background-color: #ffffff;
  color: #3A3A44;
  padding: 16rpx 32rpx;
  border: 2rpx solid #E8E2EC;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-secondary.warning {
  color: #845EC2;
  border-color: #E8E2EC;
  background-color: #FAF3FF;
}

.btn-secondary.danger {
  color: #C62828;
  border-color: #F0D5D5;
  background-color: #ffffff;
}

/* 彩色 CTA 大按钮（含副提示） */
.cta {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #ffffff;
  height: 112rpx;
  border-radius: 36rpx;
  font-size: 32rpx;
  letter-spacing: 1px;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 107, 0.3);
}
.cta-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 400;
  margin-top: 4rpx;
  letter-spacing: 0;
}

/* ---------- 设备卡 ---------- */
.device-row {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(132, 94, 194, 0.12);
}
.dev-thumb {
  width: 148rpx;
  height: 116rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #FFF1DC;
  border: 4rpx solid #FFE3B8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D9822B;
  font-size: 24rpx;
  font-weight: 700;
}
.dev-thumb image {
  width: 100%;
  height: 100%;
}
.dev-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}
.dev-name {
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34C759;
  margin-left: 14rpx;
}
.dot.off {
  background: #D9D9DD;
}
.dev-meta {
  font-size: 24rpx;
  color: #9B93A4;
  margin-top: 8rpx;
}
.dev-batt {
  text-align: center;
  margin-left: 16rpx;
  background: #FFF1DC;
  color: #D9822B;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.dev-batt .num {
  font-size: 28rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  display: block;
}
.dev-batt .t {
  font-size: 18rpx;
  display: block;
  margin-top: 2rpx;
}

/* ---------- 最近使用 ---------- */
.recent-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.recent {
  flex: none;
  width: calc((100% - 48rpx) / 3);
  min-width: 0;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 14rpx rgba(132, 94, 194, 0.1);
  padding-bottom: 14rpx;
}
.recent .r-img {
  border-radius: 0;
  overflow: hidden;
  background: #F6EFEA;
  aspect-ratio: 4/3;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D8B79A;
  font-size: 22rpx;
  font-weight: 600;
}
.recent .r-img image {
  width: 100%;
  height: 100%;
}
.recent .r-name {
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 14rpx;
  padding: 0 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent .r-time {
  font-size: 20rpx;
  color: #9B93A4;
  margin-top: 4rpx;
  padding: 0 16rpx;
}

/* ---------- 一言卡 ---------- */
.quote-strip {
  margin-top: 52rpx;
  padding: 56rpx 40rpx;
  background: #ffffff;
  border-radius: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(255, 143, 199, 0.12);
}
.quote-strip .q {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #845EC2;
}
.quote-strip .qa {
  font-size: 22rpx;
  color: #9B93A4;
  margin-top: 16rpx;
  letter-spacing: 3px;
}

/* ---------- 创作页 ---------- */
.create-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 28rpx;
}
.m-card {
  width: calc((100% - 28rpx) / 2);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 36rpx;
  padding: 40rpx 36rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
}
.m-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #F4F4F5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111111;
  margin-bottom: 28rpx;
  font-size: 40rpx;
  font-weight: 600;
}
.m-name {
  font-size: 30rpx;
  font-weight: 800;
}
.m-sub {
  font-size: 22rpx;
  color: #9B93A4;
  margin-top: 6rpx;
}
.m-badge::after {
  content: "新";
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: #FFD93D;
  color: #6B5B00;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 800;
}
.adv-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 32rpx;
  padding: 40rpx 36rpx;
  border: 2rpx solid transparent;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(132, 94, 194, 0.1);
}
.adv-row .m-ic {
  margin-bottom: 0;
}
.adv-row .m-name {
  font-size: 28rpx;
}
.adv-row .m-sub {
  font-size: 22rpx;
}
.adv-a {
  margin-left: auto;
  color: #D0C0E8;
  font-size: 32rpx;
}

/* ---------- 片单页 ---------- */
.panel-c {
  background: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  padding: 8rpx 36rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(132, 94, 194, 0.1);
}
.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}
.panel-head .cnt {
  font-size: 22rpx;
  color: #9B93A4;
  font-weight: 600;
}
.list-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 8rpx;
  border-bottom: 2rpx solid #F5EFE8;
}
.list-row:last-child {
  border-bottom: none;
}
.lr-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #F6EFEA;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D8B79A;
  font-size: 22rpx;
  font-weight: 600;
}
.lr-info {
  flex: 1;
  min-width: 0;
}
.lr-name {
  font-size: 29rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lr-meta {
  font-size: 22rpx;
  color: #9B93A4;
  margin-top: 6rpx;
}
.lr-tag {
  font-size: 20rpx;
  color: #ffffff;
  background: #4ECDC4;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.lr-tag.on {
  background: #FF6B6B;
  color: #ffffff;
}

/* ---------- 开关（自定义） ---------- */
.switch-off,
.switch-on {
  width: 84rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #E8E0D6;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s ease;
}
.switch-on {
  background: #4ECDC4;
}
.switch-on::after,
.switch-off::after {
  content: "";
  position: absolute;
  top: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  transition: left 0.2s ease;
}
.switch-on::after {
  right: 6rpx;
}
.switch-off::after {
  left: 6rpx;
}

/* ---------- 设置页分组 ---------- */
.set-group {
  background: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  overflow: hidden;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(132, 94, 194, 0.1);
}
.set-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 36rpx 40rpx;
  border-top: 2rpx solid #F7F1EC;
}
.set-row:first-child {
  border-top: none;
}
.set-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #F4F4F5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.set-t {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: baseline;
}
.set-d {
  font-size: 24rpx;
  color: #9B93A4;
  margin-left: 12rpx;
  font-weight: 400;
}
.set-a {
  color: #E0D6DD;
  font-size: 36rpx;
  font-weight: 300;
}

/* ---------- 状态 ---------- */
.status-bar {
  text-align: center;
  padding: 24rpx;
  border-radius: 36rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}
.status-bar.disconnected {
  background-color: #ffffff;
  color: #9B93A4;
  border: 2rpx solid #E8E2EC;
}
.status-bar.connected {
  background: linear-gradient(135deg, #FF6B6B, #FF9F6B);
  color: #fff;
}

/* ---------- 设置区块（兼容旧子页） ---------- */
.settings-section {
  background-color: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(132, 94, 194, 0.1);
}
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 36rpx;
  background-color: #FBF5F0;
  border-bottom: 2rpx solid #F5EFE8;
  font-weight: 700;
  color: #845EC2;
  font-size: 30rpx;
}
.section-content {
  padding: 30rpx 36rpx;
}
.setting-item {
  margin-bottom: 24rpx;
}
.setting-item:last-child {
  margin-bottom: 0;
}
.setting-label {
  font-weight: 600;
  color: #6B646F;
  font-size: 28rpx;
}
.setting-value {
  color: #3A3A44;
  font-weight: 600;
  font-size: 28rpx;
}

/* ---------- 进度条 ---------- */
.transfer-container {
  margin: 24rpx 0;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid #F0E4DE;
}
.transfer-status {
  text-align: center;
  font-size: 26rpx;
  color: #3A3A44;
  margin-bottom: 16rpx;
  font-weight: 600;
}
.progress-bar {
  width: 100%;
  height: 32rpx;
  background-color: #F0E4DE;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF9F6B);
  transition: width 0.3s ease;
  border-radius: 999rpx;
}
.transfer-progress {
  text-align: center;
  font-size: 26rpx;
  color: #9B93A4;
  margin-top: 12rpx;
  font-weight: 600;
}

/* ---------- 文件列表 ---------- */
.file-list {
  max-height: 300rpx;
  overflow-y: auto;
  border: 2rpx solid #F0E4DE;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}
.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #F5EFE8;
}
.file-item:last-child {
  border-bottom: none;
}
.file-item.displaying {
  background-color: #FFF1F1;
  border-left: 6rpx solid #FF6B6B;
}
.file-id {
  min-width: 60rpx;
  font-weight: 600;
  color: #845EC2;
  margin-right: 20rpx;
  font-size: 26rpx;
}
.file-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  color: #3A3A44;
}
.empty-state {
  text-align: center;
  padding: 40rpx;
  color: #9B93A4;
  font-size: 26rpx;
}

/* ---------- 模式选择 ---------- */
.mode-selector {
  display: flex;
  gap: 20rpx;
}
.mode-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background-color: #FBF5F0;
  border: 4rpx solid transparent;
  border-radius: 32rpx;
  color: #9B93A4;
  font-weight: 600;
  font-size: 26rpx;
}
.mode-button.active {
  background-color: #FFF1F1;
  border-color: #FF6B6B;
  color: #FF6B6B;
}

/* ---------- 开关行 / 按钮行 ---------- */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5EFE8;
}
.switch-row:last-child {
  border-bottom: none;
}
.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.button-row .btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* ---------- 画布容器 ---------- */
.canvas-container {
  background: #ffffff;
  padding: 40rpx 30rpx 80rpx 30rpx;
  border: 2rpx solid #F0E4DE;
  border-radius: 40rpx;
  margin: 24rpx auto;
  width: fit-content;
  max-width: 100%;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.08);
}

/* ---------- 信息文本 ---------- */
.info-text {
  color: #9B93A4;
  font-size: 24rpx;
  text-align: center;
  margin: 16rpx 0;
}
.success-text {
  color: #2EB6AC;
  font-size: 26rpx;
  margin-top: 16rpx;
}
.error-text {
  color: #C62828;
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* ---------- 滑块 ---------- */
.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.slider-label {
  flex: 0 0 180rpx;
  font-weight: 600;
  color: #6B646F;
  font-size: 26rpx;
}
.slider-row slider {
  flex: 1;
}
.slider-value {
  flex: 0 0 80rpx;
  text-align: right;
  font-weight: 600;
  font-size: 26rpx;
}

/* ---------- 按钮组 / 操作项 ---------- */
.btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.btn-group .btn-secondary {
  flex: 1;
  min-width: 140rpx;
  text-align: center;
}
.action-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5EFE8;
}
.action-item:last-child {
  border-bottom: none;
}
.action-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
  color: #6B646F;
  font-size: 28rpx;
}
.action-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.file-size-text {
  font-size: 24rpx;
  color: #9B93A4;
}

/* ---------- 唤醒滑块 ---------- */
.wake-slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.wake-min, .wake-max {
  font-size: 22rpx;
  color: #9B93A4;
  white-space: nowrap;
}
.wake-slider-row slider {
  flex: 1;
}

/* ---------- 调试日志 ---------- */
.debug-log {
  background-color: #3A3A44;
  color: #E8E2EC;
  padding: 16rpx;
  font-family: monospace;
  font-size: 20rpx;
  max-height: 300rpx;
  overflow-y: auto;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}
.debug-entry {
  margin: 4rpx 0;
  padding: 4rpx 0;
  border-bottom: 2rpx solid #5A5560;
}
.debug-entry.error {
  color: #FF8A8A;
}
.debug-entry.success {
  color: #8FE8DF;
}
.debug-entry.info {
  color: #9FC9FF;
}

/* ---------- 全局动画 ---------- */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.settings-section,
.device-row,
.panel-c,
.set-group,
.m-card,
.adv-row {
  animation: slideUp 0.4s ease both;
}

.btn-primary:active,
.cta:active,
.btn-secondary:active,
.m-card:active,
.adv-row:active,
.list-row:active,
.set-row:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.transfer-container {
  animation: scaleIn 0.3s ease;
}
